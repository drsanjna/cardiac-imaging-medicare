# Copy to .env (never commit .env). All values are optional; defaults shown.

# Raw inputs
CMS_CSV_DIR=~/Downloads                         # where the yearly claims CSVs are
CMS_PARQUET_DIR=~/Downloads/cms_parquet         # Parquet output + cms.duckdb
CMS_REFERENCE_DIR=~/Downloads/Data              # 'original medicare enrollment 2018/2023.xlsx'
CMS_GV_GLOB=~/Downloads/Medicare_GV_by_National_State_County_2024_copy*.csv

# Analysis database (default: $CMS_PARQUET_DIR/cms.duckdb). Use md:<name> + MOTHERDUCK_TOKEN for a cloud copy.
CARDIAC_DB=
MOTHERDUCK_TOKEN=

# Optional: fine-grained GitHub token (this repo only; Issues read/write) so a failed run opens
# a `notebook-error` issue that the Claude GitHub Action answers. Unset = only logs/last_error.md.
CARDIAC_GITHUB_TOKEN=
CARDIAC_REPORT_ERRORS=1

# Where figures and logs go (relative paths are inside the repo)
CARDIAC_OUTPUT_DIR=outputs
CARDIAC_LOG_DIR=logs
